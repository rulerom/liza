// The C harness invokes this function on a native worker thread. Only scalar
// inputs and outputs cross the boundary; all other state is worker-local.
fn mt_worker(id:u32)->u32 {
    var total:u32 = 0
    var i:u32 = 0
    while i < 10000 {
        total = total + id + 1
        i = i + 1
    }
    return total
}
fn main()->u32 { return 0 }

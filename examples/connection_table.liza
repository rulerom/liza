import tables.connections

fn main() -> u32 {
    first = tables.connections.add(tables.connections.empty(), tables.connections.Connection(42, 1, 0))
    match first.result {
        Err(e) => { return 1 }
        Ok(alice) => {
            edited = tables.connections.edit(first.table, alice, tables.connections.Connection(42, 2, 10))
            match edited.result { Err(e) => { return 2 } Ok(done) => {} }
            removed = tables.connections.del(edited.table, alice)
            match removed.result { Err(e) => { return 3 } Ok(done) => {} }
            next = tables.connections.add(removed.table, tables.connections.Connection(99, 1, 0))
            match next.result {
                Err(e) => { return 4 }
                Ok(bob) => {
                    if bob.slot != alice.slot || bob.generation == alice.generation { return 5 }
                    match tables.connections.get(next.table, alice) { Some(c) => { return 6 } None => {} }
                    match tables.connections.get(next.table, bob) {
                        None => { return 7 }
                        Some(c) => { if c.user_id != 99 { return 8 } }
                    }
                }
            }
        }
    }
    return 0
}

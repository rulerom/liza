// RTP v2 fixed header, CSRC list, extension length and padding (RFC 3550).
pub enum ParseError { TooShort; BadVersion; TruncatedCsrc; TruncatedExtension; BadPadding }
pub struct RtpHeader { version:u8; marker:bool; payload_type:u8; sequence:u16; timestamp:u32; pub ssrc:u32; payload_offset:u32; payload_length:u32 }
fn be16(data:View<u8>, i:u32)->u16 { return (u16(data[i]) << 8) | u16(data[i+1]) }
fn be32(data:View<u8>, i:u32)->u32 { return (u32(be16(data,i)) << 16) | u32(be16(data,i+2)) }
pub fn parse(data:View<u8>)->Result<RtpHeader,ParseError> {
    if data.len < 12 { return Err(ParseError.TooShort) }
    version = data[0] >> 6
    if version != 2 { return Err(ParseError.BadVersion) }
    var offset = 12 + 4 * u32(data[0] & 15)
    if data.len < offset { return Err(ParseError.TruncatedCsrc) }
    if (data[0] & 16) != 0 {
        if data.len-offset < 4 { return Err(ParseError.TruncatedExtension) }
        size = 4 * u32(be16(data,offset+2))
        if size > data.len-offset-4 { return Err(ParseError.TruncatedExtension) }
        offset = offset+4+size
    }
    var length = data.len-offset
    if (data[0] & 32) != 0 {
        if length == 0 { return Err(ParseError.BadPadding) }
        padding = u32(data[data.len-1])
        if padding == 0 || padding > length { return Err(ParseError.BadPadding) }
        length = length-padding
    }
    return Ok(RtpHeader(version,(data[1]&128)!=0,data[1]&127,be16(data,2),be32(data,4),be32(data,8),offset,length))
}

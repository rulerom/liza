// Build: python3 -m liza build examples/apps/liza_json.liza --project-root examples -o build/liza-json
import text.string
import text.builder
import text.json_format
fn diagnostic(message:Text,code:u32)->u32:io {
    match console.errln(message) {Ok(n)=>{return code} Err(e)=>{return 3}}
}
fn report(result:Result<u64,JsonError>)->u32:io {
    match result {
        Ok(count)=>{match console.println("OK") {Ok(n)=>{return 0} Err(e)=>{return 3}}}
        Err(error)=>{
            var label:Text="Syntax"
            var code:u32=1
            match error.kind {
                JsonErrorKind.Syntax=>{}
                JsonErrorKind.InvalidNumber=>{label="InvalidNumber"}
                JsonErrorKind.InvalidEscape=>{label="InvalidEscape"}
                JsonErrorKind.InvalidSurrogate=>{label="InvalidSurrogate"}
                JsonErrorKind.InvalidUtf8=>{label="InvalidUtf8"}
                JsonErrorKind.UnexpectedEof=>{label="UnexpectedEof"}
                JsonErrorKind.DepthLimit=>{label="DepthLimit";code=4}
                JsonErrorKind.SizeOverflow=>{label="SizeOverflow";code=4}
            }
            match console.err(label) {Ok(n)=>{} Err(e)=>{return 3}}
            match console.err(" at byte ") {Ok(n)=>{} Err(e)=>{return 3}}
            match console.err_u64(error.offset) {Ok(n)=>{} Err(e)=>{return 3}}
            match console.errln("") {Ok(n)=>{} Err(e)=>{return 3}}
            return code
        }
    }
}
fn run(path:Path)->u32:io {
    match file.open_path(path) {
        Err(error)=>{return diagnostic("Cannot open file",3)}
        Ok(input)=>{
            var state=json.create()
            var failed:bool=false
            var done:bool=false
            while !done {
                match file.read_chunk(input) {
                    Err(error)=>{failed=true;break}
                    Ok(chunk)=>{
                        if chunk.eof {break}
                        bytes=chunk.data
                        data=view bytes[0..chunk.len]
                        state=json.feed(state,data)
                        match json.status(state) {Some(e)=>{done=true} None=>{}}
                    }
                }
            }
            match file.close(move input) {Err(error)=>{return diagnostic("Cannot close file",3)} Ok(closed)=>{}}
            if failed {return diagnostic("Cannot read file",3)}
            return report(json.finish(state))
        }
    }
}
// Return ownership on every outcome. No rollback/retry after partial stdout I/O.
struct Emitted {text:text.string.String;ok:bool}
fn emit(initial:text.string.String,data:View<u8>)->Emitted:io {
    var output=move initial
    if data.len>text.string.capacity(output)-text.string.length(output) {
        match text.string.write(output) {
            Err(e)=>{return Emitted(move output,false)}
            Ok(n)=>{if n!=u64(text.string.length(output)) {return Emitted(move output,false)}}
        }
        output=text.string.clear(move output)
    }
    (next,status)=text.builder.append(move output,data)
    match status {
        Err(e)=>{return Emitted(move next,false)}
        Ok(done)=>{return Emitted(move next,true)}
    }
}
fn format_stream(input:File,storage:memory.Buffer<u8>)->u32:io {
    var output=text.string.from_buffer(move storage)
    var state=text.json_format.create()
    var failure:Option<JsonError> = None
    var io_failed=false
    var done=false
    while !done {
        match file.read_chunk(input) {
            Err(e)=>{io_failed=true;break}
            Ok(chunk)=>{
                if chunk.eof {break}
                bytes=chunk.data
                var i:u32=0
                while i<chunk.len {
                    match text.json_format.feed_byte(borrow mut state,bytes[i]) {
                        Err(e)=>{failure=Some(e);done=true;break}
                        Ok(piece)=>{
                            if piece.length>0 {
                                data=piece.data;prefix=view data[0..piece.length]
                                (next,ok)=emit(move output,prefix);output=move next
                                if !ok {io_failed=true;done=true;break}
                            }
                        }
                    }
                    i=i+1
                }
            }
        }
    }
    if !done && !io_failed {
        match text.json_format.finish(state) {
            Err(e)=>{failure=Some(e)}
            Ok(count)=>{
                newline:[u8;1]=[10];v=view newline[0..1]
                (next,ok)=emit(move output,v);output=move next
                if !ok {io_failed=true}
                else {
                    match text.string.write(output) {
                        Err(e)=>{io_failed=true}
                        Ok(n)=>{if n!=u64(text.string.length(output)) {io_failed=true}}
                    }
                }
            }
        }
    }
    released=text.string.release(move output)
    match file.close(move input) {Err(e)=>{return diagnostic("Cannot close file",3)} Ok(closed)=>{}}
    if io_failed {return diagnostic("Cannot read or write JSON",3)}
    match failure {Some(e)=>{return report(Err(e))} None=>{return 0}}
}
fn format(path:Path)->u32:io,alloc {
    match memory.create(2048) {Err(e)=>{return diagnostic("Cannot allocate output",3)} Ok(region)=>{
        var status:u32=0
        match memory.alloc<u8>(region,2048,0) {
            Err(e)=>{status=diagnostic("Cannot allocate output",3)}
            Ok(storage)=>{
                match file.open_path(path) {
                    Err(e)=>{released=memory.release(move storage);status=diagnostic("Cannot open file",3)}
                    Ok(input)=>{status=format_stream(move input,move storage)}
                }
            }
        }
        closed=memory.close(move region);return status
    }}
}
fn usage()->u32:io {
    return diagnostic("Usage: liza-json <check|format> <file>\nformat streams to stdout; errors may leave partial output. Do not redirect to the input file.",2)
}
fn main()->u32:io,alloc {
    if cli.count()!=3 {return usage()}
    match cli.arg(1) {
        None=>{return usage()}
        Some(command)=>{
            if !cli.equals(command,"check") && !cli.equals(command,"format") {return usage()}
            match cli.path_arg(2) {None=>{return usage()} Some(path)=>{
                if cli.equals(command,"format") {return format(path)}
                return run(path)
            }}
        }
    }
}

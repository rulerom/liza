// Ordinary source module: no String-specific compiler or runtime support.
// Only this module can construct or unpack String.
pub struct String {storage:memory.Buffer<u8>;length:u32}
pub struct Done {}
pub enum Error {InvalidUtf8(Utf8Error);Full}
pub struct Appended {pub text:String;pub status:Result<Done,Error>}
pub struct Info {pub text:String;pub length:u32;pub capacity:u32}

// Takes an already allocated buffer; its old contents are not text.
// The logical string starts empty, with exactly the supplied capacity.
pub fn from_buffer(storage:memory.Buffer<u8>)->String {
    return String(move storage,0)
}

// Validate all input and capacity before modifying even one byte.
// Invalid UTF-8 has priority over Full. Each append is a complete UTF-8 value.
pub fn append(text:String,data:View<u8>)->Appended {
    (initial,length)=move text
    match utf8.validate(data) {
        Err(error)=>{return Appended(String(move initial,length),Err(Error.InvalidUtf8(error)))}
        Ok(done)=>{}
    }
    capacity=memory.len(initial)
    if data.len>capacity-length {return Appended(String(move initial,length),Err(Error.Full))}
    var storage=move initial
    var i:u32=0
    while i<data.len {
        storage=memory.set(move storage,length+i,data[i])
        i=i+1
    }
    return Appended(String(move storage,length+data.len),Ok(Done()))
}

pub fn clear(text:String)->String {
    (storage,length)=move text
    return String(move storage,0)
}

// T1 consuming inspection remains available; T2 observations are below.
pub fn inspect(text:String)->Info {
    (storage,length)=move text
    capacity=memory.len(storage)
    return Info(String(move storage,length),length,capacity)
}

// Non-consuming observations. Borrow never exposes the private buffer as owned.
pub fn length(borrow text:String)->u32 {return text.length}
pub fn capacity(borrow text:String)->u32 {return memory.len(text.storage)}

// Byte index, not code-point index. The local view never leaves this function.
pub fn byte_at(borrow text:String,index:u32)->Option<u8> {
    if index>=text.length {return None}
    data=memory.view(text.storage)
    return Some(data[index])
}

pub fn release(text:String)->u32 {
    (storage,length)=move text
    return memory.release(move storage)
}

// Validating streaming whitespace formatter, not a public JSON tokenizer.
// Lexemes (including numeric precision and escape spelling) are preserved.
pub struct State {
    parser:JsonState;depth:u32;quoted:bool;escaped:bool;pending:bool
    scalar:[u8;4];have:u32;need:u32
}
pub struct Piece {pub data:[u8;132];pub length:u32}

pub fn create()->State {
    return State(json.create(),0,false,false,false,[0;4],0,0)
}
fn put(borrow mut p:Piece,byte:u8)->u32 {
    p.data[p.length]=byte;p.length=p.length+1;return 0
}
fn indent(borrow mut p:Piece,depth:u32)->u32 {
    a=put(borrow mut p,10)
    var i:u32=0
    while i<depth*2 {b=put(borrow mut p,32);i=i+1}
    return 0
}
pub fn feed_byte(borrow mut s:State,byte:u8)->Result<Piece,JsonError> {
    raw:[u8;1]=[byte];v=view raw[0..1]
    // Existing validator is authoritative, including UTF-8 and error offsets.
    s.parser=json.feed(s.parser,v)
    match json.status(s.parser) {Some(e)=>{return Err(e)} None=>{}}
    var out=Piece([0;132],0)
    if s.need>0 {
        s.scalar[s.have]=byte;s.have=s.have+1;s.need=s.need-1
        if s.need==0 {
            var i:u32=0
            while i<s.have {a=put(borrow mut out,s.scalar[i]);i=i+1}
            s.have=0
        }
        return Ok(out)
    }
    if s.quoted {
        if byte>=128 {
            s.scalar[0]=byte;s.have=1
            if byte<224 {s.need=1} else {if byte<240 {s.need=2} else {s.need=3}}
            return Ok(out)
        }
        a=put(borrow mut out,byte)
        if s.escaped {s.escaped=false}
        else {if byte==92 {s.escaped=true} else {if byte==34 {s.quoted=false}}}
        return Ok(out)
    }
    if byte==32 || byte==9 || byte==10 || byte==13 {return Ok(out)}
    if byte==93 || byte==125 {
        s.depth=s.depth-1
        if !s.pending {a=indent(borrow mut out,s.depth)}
        s.pending=false;a=put(borrow mut out,byte);return Ok(out)
    }
    if s.pending {a=indent(borrow mut out,s.depth);s.pending=false}
    if byte==44 {
        a=put(borrow mut out,byte);b=indent(borrow mut out,s.depth);return Ok(out)
    }
    a=put(borrow mut out,byte)
    if byte==58 {b=put(borrow mut out,32)}
    if byte==91 || byte==123 {s.depth=s.depth+1;s.pending=true}
    if byte==34 {s.quoted=true}
    return Ok(out)
}
pub fn finish(borrow s:State)->Result<u64,JsonError> {return json.finish(s.parser)}

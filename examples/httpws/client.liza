import httpws.bytes
import httpws.crypto
import httpws.http
import httpws.websocket
// Status: 0=clean close, 2=config, 3=transport/entropy, 4=protocol, 5=deadline.
fn retry(e:ReactorError)->bool {
    match e {ReactorError.Interrupted=>{return true} ReactorError.WouldBlock=>{return true}
    ReactorError.AddressInUse=>{return false} ReactorError.PermissionDenied=>{return false}
    ReactorError.Disconnected=>{return false} ReactorError.InvalidRange=>{return false}
    ReactorError.Other=>{return false} ReactorError.InvalidCapacity=>{return false}
    ReactorError.Full=>{return false} ReactorError.InvalidConnection=>{return false}
    ReactorError.Exhausted=>{return false} ReactorError.OutOfMemory=>{return false}}
}
fn masked(opcode:u8,data:View<u8>)->Result<httpws.bytes.Wire,u32>:io {
    match net.random_u32() {
        Err(e)=>{return Err(3)}
        Ok(mask)=>{match httpws.websocket.frame(opcode,data,mask) {Err(e)=>{return Err(4)} Ok(w)=>{return Ok(w)}}}
    }
}
fn exchange(r:net.Reactor,id:net.Connection,storage:memory.Buffer<u8>,request:httpws.bytes.Wire,proof:[u8;28],message:View<u8>,deadline:u64,websocket:bool)->u32:io,alloc {
    var input=move storage
    var pending=request;var sent:u32=0
    var status:u32=0;var connected=false;var closed=false;var upgraded=false
    var count:u32=0;var cursor:u32=0
    var head=httpws.bytes.empty();var parser=httpws.websocket.create()
    var body_size:u32=0;var expected_size:Option<u32> =None
    while status==0 {
        if closed && pending.len==0 {break}
        // Keep unread bytes across partial writes and control replies. This bounds
        // output to one frame without losing coalesced input or allocating a queue.
        if connected && pending.len==0 && cursor<count {
            var byte:u8=0
            {data=memory.view(input);byte=data[cursor]}
            cursor=cursor+1
            if !upgraded {
                if !httpws.bytes.put(borrow mut head,byte) {status=4}
                if head.len>=4 {
                    n=head.len
                    if head.data[n-4]==13 && head.data[n-3]==10 && head.data[n-2]==13 && head.data[n-1]==10 {
                        header=head.data
                        if websocket {match httpws.http.upgrade(view header[0..n],proof) {
                            Err(e)=>{status=4}
                            Ok(value)=>{match value {None=>{status=4} Some(h)=>{upgraded=true}}}
                        }
                        if status==0 {match masked(1,message) {Err(e)=>{status=e} Ok(w)=>{pending=w;sent=0}}}
                        } else {
                            match httpws.http.response(view header[0..n]) {
                                Err(e)=>{status=4}
                                Ok(value)=>{match value {None=>{status=4} Some(h)=>{
                                    match httpws.http.body_length(view header[0..n],h) {
                                        Err(e)=>{status=4}
                                        Ok(length)=>{expected_size=length;upgraded=true;match length {None=>{} Some(size)=>{if size==0 {closed=true}}}}
                                    }
                                }}}
                            }
                        }
                    }
                }
            } else if !websocket {
                if body_size==4096 {status=4}
                else {
                    body_size=body_size+1
                    single:[u8;1]=[byte]
                    match console.write_bytes(view single[0..1]) {Ok(n)=>{} Err(e)=>{status=3}}
                    match expected_size {None=>{} Some(size)=>{if body_size==size {closed=true}}}
                }
            } else {
                match httpws.websocket.feed(borrow mut parser,byte) {
                    Err(e)=>{status=4}
                    Ok(event)=>{
                        if event==1 || event==2 {
                            body=parser.message
                            match console.write_bytes(view body[0..parser.size]) {Ok(n)=>{} Err(e)=>{status=3}}
                        }
                        if event==9 || event==8 {
                            control=parser.control;var opcode:u8=10
                            if event==8 {opcode=8;closed=true}
                            match masked(opcode,view control[0..parser.control_size]) {Err(e)=>{status=e} Ok(w)=>{pending=w;sent=0}}
                        }
                    }
                }
            }
        } else {
            var now:u64=0
            match net.monotonic_ms() {Err(e)=>{status=3} Ok(n)=>{now=n}}
            if status==0 && now>=deadline {status=5}
            var interest:u32=1
            if !connected || pending.len!=0 {interest=2}
            if status==0 {
                match net.reactor_interest(r,id,interest) {Err(e)=>{status=3} Ok(n)=>{}}
                if status==0 {match net.reactor_poll(r,u32(deadline-now)) {Err(e)=>{if !retry(e) {status=3}} Ok(n)=>{}}}
                var flags:u32=0
                if status==0 {match net.reactor_ready(r,id) {Err(e)=>{status=3} Ok(n)=>{flags=n}}}
                if status==0 && !connected && (flags&6)!=0 {
                    match net.reactor_finish_connect(r,id) {Err(e)=>{if !retry(e) {status=3}} Ok(done)=>{connected=done}}
                }
                if status==0 && connected {
                    if pending.len!=0 && (flags&6)!=0 {
                        wire=pending.data
                        match net.reactor_write(r,id,view wire[0..pending.len],sent,pending.len-sent) {
                            Err(e)=>{if !retry(e) {status=3}}
                            Ok(n)=>{if n==0 {status=3} else {sent=sent+n;if sent==pending.len {pending.len=0;sent=0}}}
                        }
                    } else if pending.len==0 && cursor==count && (flags&5)!=0 {
                        (next,result)=net.reactor_read(r,id,move input,0,4096);input=move next
                        match result {Err(e)=>{if !retry(e) {status=3}} Ok(n)=>{count=n;cursor=0;if n==0 {
                            if !websocket && upgraded {match expected_size {None=>{closed=true} Some(size)=>{status=4}}}
                            else {status=4}
                        }}}
                    }
                }
            }
        }
    }
    released=memory.release(move input)
    match net.reactor_close(move r) {Ok(n)=>{} Err(e)=>{status=3}}
    return status
}
pub fn run(address:net.Address,host:View<u8>,target:View<u8>,message:View<u8>,timeout_ms:u32)->u32:io,alloc {
    if timeout_ms==0 || timeout_ms>2147483647 {return 2}
    var nonce:[u8;16]=[0;16];var i:u32=0
    while i<4 {
        match net.random_u32() {
            Err(e)=>{return 3}
            Ok(n)=>{nonce[i*4]=u8.wrap(n>>24);nonce[i*4+1]=u8.wrap(n>>16);nonce[i*4+2]=u8.wrap(n>>8);nonce[i*4+3]=u8.wrap(n)}
        }
        i=i+1
    }
    key=httpws.crypto.key(nonce)
    var deadline:u64=0
    match net.monotonic_ms() {Err(e)=>{return 3} Ok(now)=>{deadline=now+u64(timeout_ms)}}
    match httpws.http.request(host,target,key) {
        Err(e)=>{return 2}
        Ok(request)=>{
            return start(address,request,httpws.crypto.accept(key),message,deadline,true)
        }
    }
}

fn start(address:net.Address,request:httpws.bytes.Wire,proof:[u8;28],message:View<u8>,deadline:u64,websocket:bool)->u32:io,alloc {
    match net.reactor_create(0,1) {
        Err(e)=>{return 3}
        Ok(r)=>{
            match net.reactor_stop_accepting(r) {Err(e)=>{c=net.reactor_close(move r);return 3} Ok(n)=>{}}
            match net.reactor_connect_at(r,address) {
                Err(e)=>{c=net.reactor_close(move r);return 3}
                Ok(id)=>{
                    match memory.create(4096) {
                        Err(e)=>{c=net.reactor_close(move r);return 3}
                        Ok(region)=>{
                            match memory.alloc<u8>(region,4096,0) {
                                Err(e)=>{f=memory.close(move region);c=net.reactor_close(move r);return 3}
                                Ok(input)=>{
                                    status=exchange(move r,id,move input,request,proof,message,deadline,websocket)
                                    f=memory.close(move region);return status
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
pub fn get(address:net.Address,host:View<u8>,target:View<u8>,timeout_ms:u32)->u32:io,alloc {
    if timeout_ms==0 || timeout_ms>2147483647 {return 2}
    var deadline:u64=0
    match net.monotonic_ms() {Err(e)=>{return 3} Ok(now)=>{deadline=now+u64(timeout_ms)}}
    empty:[u8;1]=[0];proof:[u8;28]=[0;28]
    match httpws.http.get(host,target) {Err(e)=>{return 2} Ok(request)=>{return start(address,request,proof,view empty[0..0],deadline,false)}}
}

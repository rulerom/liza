import httpws.bytes
pub enum Error { Invalid; TooLarge; Rejected }
pub struct Head {pub status:u32;pub end:u32}
fn crlf(data:View<u8>,start:u32)->u32 {
    var i=start
    while i+1<data.len {if data[i]==13 && data[i+1]==10 {return i};i=i+1}
    return data.len
}
fn token(b:u8)->bool {
    return (b>=48 && b<=57)||(b>=65 && b<=90)||(b>=97 && b<=122)||b==33||b==35||b==36||b==37||b==38||b==39||b==42||b==43||b==45||b==46||b==94||b==95||b==96||b==124||b==126
}
// None means incomplete. end leaves any coalesced protocol/body bytes untouched.
pub fn response(data:View<u8>)->Result<Option<Head>,Error> {
    var end:u32=0;var i:u32=0
    while i+3<data.len && i<8192 {
        if data[i]==13 && data[i+1]==10 && data[i+2]==13 && data[i+3]==10 {end=i+4;break}
        i=i+1
    }
    if end==0 {if data.len>=8192 {return Err(Error.TooLarge)};return Ok(None)}
    if end>8192 {return Err(Error.TooLarge)}
    line=crlf(data,0)
    version:[u8;9]=[72,84,84,80,47,49,46,49,32]
    if line<12 || !httpws.bytes.equal(data,0,9,view version[0..9],false) {return Err(Error.Invalid)}
    if line>12 && data[12]!=32 {return Err(Error.Invalid)}
    var status:u32=0;i=9
    while i<12 {if data[i]<48 || data[i]>57 {return Err(Error.Invalid)};status=status*10+u32(data[i])-48;i=i+1}
    if status<100 {return Err(Error.Invalid)}
    i=12;while i<line {if data[i]<32 || data[i]>126 {return Err(Error.Invalid)};i=i+1}
    var pos=line+2
    while pos<end-2 {
        next=crlf(data,pos);var colon=pos
        while colon<next && token(data[colon]) {colon=colon+1}
        if colon==pos || colon>=next || data[colon]!=58 {return Err(Error.Invalid)}
        i=colon+1
        while i<next {if (data[i]<32 && data[i]!=9)||data[i]==127 {return Err(Error.Invalid)};i=i+1}
        pos=next+2
    }
    return Ok(Some(Head(status,end)))
}
fn contains(data:View<u8>,start:u32,end:u32,word:View<u8>)->bool {
    var pos=start
    while pos<end {
        var next=pos;while next<end && data[next]!=44 {next=next+1}
        var a=pos;var b=next
        while a<b && (data[a]==32 || data[a]==9) {a=a+1}
        while b>a && (data[b-1]==32 || data[b-1]==9) {b=b-1}
        if httpws.bytes.equal(data,a,b,word,true) {return true}
        pos=next+1
    }
    return false
}
pub fn upgrade(data:View<u8>,expected:[u8;28])->Result<Option<Head>,Error> {
    match response(data) {
        Err(e)=>{return Err(e)}
        Ok(value)=>{match value {
        None=>{return Ok(None)}
        Some(head)=>{
            if head.status!=101 {return Err(Error.Rejected)}
            var pos=crlf(data,0)+2;var flags:u32=0
            upgrade_name:[u8;7]=[117,112,103,114,97,100,101]
            connection:[u8;10]=[99,111,110,110,101,99,116,105,111,110]
            accept_name:[u8;20]=[115,101,99,45,119,101,98,115,111,99,107,101,116,45,97,99,99,101,112,116]
            extension:[u8;24]=[115,101,99,45,119,101,98,115,111,99,107,101,116,45,101,120,116,101,110,115,105,111,110,115]
            protocol:[u8;22]=[115,101,99,45,119,101,98,115,111,99,107,101,116,45,112,114,111,116,111,99,111,108]
            websocket:[u8;9]=[119,101,98,115,111,99,107,101,116]
            while pos<head.end-2 {
                end=crlf(data,pos);var colon=pos
                while data[colon]!=58 {colon=colon+1}
                var a=colon+1;var b=end
                while a<b && (data[a]==32 || data[a]==9) {a=a+1}
                while b>a && (data[b-1]==32 || data[b-1]==9) {b=b-1}
                if httpws.bytes.equal(data,pos,colon,view upgrade_name[0..7],true) {
                    if (flags&1)!=0 || !httpws.bytes.equal(data,a,b,view websocket[0..9],true) {return Err(Error.Invalid)}
                    flags=flags|1
                }
                if httpws.bytes.equal(data,pos,colon,view connection[0..10],true) {
                    if !contains(data,a,b,view upgrade_name[0..7]) {return Err(Error.Invalid)};flags=flags|2
                }
                if httpws.bytes.equal(data,pos,colon,view accept_name[0..20],true) {
                    if (flags&4)!=0 || !httpws.bytes.equal(data,a,b,view expected[0..28],false) {return Err(Error.Invalid)};flags=flags|4
                }
                if httpws.bytes.equal(data,pos,colon,view extension[0..24],true)||httpws.bytes.equal(data,pos,colon,view protocol[0..22],true) {return Err(Error.Invalid)}
                pos=end+2
            }
            if flags!=7 {return Err(Error.Invalid)}
            return Ok(Some(head))
        }
        }}
    }
}
// host is an HTTP authority; target is an already encoded origin-form URI.
pub fn request(host:View<u8>,target:View<u8>,key:[u8;24])->Result<httpws.bytes.Wire,Error> {
    if !valid_target(host,target) {return Err(Error.Invalid)}
    if key[22]!=61 || key[23]!=61 {return Err(Error.Invalid)}
    var i:u32=0
    while i<22 {
        b=key[i]
        if !((b>=65 && b<=90)||(b>=97 && b<=122)||(b>=48 && b<=57)||b==43||b==47) {return Err(Error.Invalid)}
        i=i+1
    }
    if !(key[21]==65 || key[21]==81 || key[21]==103 || key[21]==119) {return Err(Error.Invalid)}
    var out=httpws.bytes.empty()
    get:[u8;4]=[71,69,84,32]
    // " HTTP/1.1\r\nHost: "
    http:[u8;17]=[32,72,84,84,80,47,49,46,49,13,10,72,111,115,116,58,32]
    // "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: "
    headers:[u8;89]=[13,10,85,112,103,114,97,100,101,58,32,119,101,98,115,111,99,107,101,116,13,10,67,111,110,110,101,99,116,105,111,110,58,32,85,112,103,114,97,100,101,13,10,83,101,99,45,87,101,98,83,111,99,107,101,116,45,86,101,114,115,105,111,110,58,32,49,51,13,10,83,101,99,45,87,101,98,83,111,99,107,101,116,45,75,101,121,58,32]
    end:[u8;4]=[13,10,13,10]
    a=httpws.bytes.append(borrow mut out,view get[0..4])
    b=httpws.bytes.append(borrow mut out,target)
    c=httpws.bytes.append(borrow mut out,view http[0..17])
    d=httpws.bytes.append(borrow mut out,host)
    e=httpws.bytes.append(borrow mut out,view headers[0..89])
    k=httpws.bytes.append(borrow mut out,view key[0..24])
    z=httpws.bytes.append(borrow mut out,view end[0..4])
    return Ok(out)
}

// Deliberately bounded GET profile: Content-Length or connection-close body.
// Transfer-Encoding is rejected; chunked decoding is a later independent slice.
// head must be obtained from response(data); it identifies the validated head.
pub fn body_length(data:View<u8>,head:Head)->Result<Option<u32>,Error> {
    if head.status<200 {return Err(Error.Rejected)}
    cl:[u8;14]=[99,111,110,116,101,110,116,45,108,101,110,103,116,104]
    te:[u8;17]=[116,114,97,110,115,102,101,114,45,101,110,99,111,100,105,110,103]
    var length:Option<u32> =None;var pos=crlf(data,0)+2
    while pos<head.end-2 {
        end=crlf(data,pos);var colon=pos
        while data[colon]!=58 {colon=colon+1}
        if httpws.bytes.equal(data,pos,colon,view te[0..17],true) {return Err(Error.Rejected)}
        if httpws.bytes.equal(data,pos,colon,view cl[0..14],true) {
            match length {None=>{} Some(n)=>{return Err(Error.Invalid)}}
            var a=colon+1;var b=end
            while a<b && (data[a]==32 || data[a]==9) {a=a+1}
            while b>a && (data[b-1]==32 || data[b-1]==9) {b=b-1}
            if a==b {return Err(Error.Invalid)}
            var n:u32=0
            while a<b {
                if data[a]<48 || data[a]>57 {return Err(Error.Invalid)}
                digit=u32(data[a])-48
                if n>409 || (n==409 && digit>6) {return Err(Error.TooLarge)}
                n=n*10+digit;a=a+1
            }
            length=Some(n)
        }
        pos=end+2
    }
    if head.status==204 || head.status==304 {return Ok(Some(0))}
    return Ok(length)
}
pub fn get(host:View<u8>,target:View<u8>)->Result<httpws.bytes.Wire,Error> {
    // Reuse request-target/authority validation, without negotiating WebSocket.
    if !valid_target(host,target) {return Err(Error.Invalid)}
    var out=httpws.bytes.empty()
    method:[u8;4]=[71,69,84,32]
    version:[u8;17]=[32,72,84,84,80,47,49,46,49,13,10,72,111,115,116,58,32]
    // "\r\nConnection: close\r\nAccept-Encoding: identity\r\n\r\n"
    end:[u8;50]=[13,10,67,111,110,110,101,99,116,105,111,110,58,32,99,108,111,115,101,13,10,65,99,99,101,112,116,45,69,110,99,111,100,105,110,103,58,32,105,100,101,110,116,105,116,121,13,10,13,10]
    a=httpws.bytes.append(borrow mut out,view method[0..4])
    b=httpws.bytes.append(borrow mut out,target)
    c=httpws.bytes.append(borrow mut out,view version[0..17])
    d=httpws.bytes.append(borrow mut out,host)
    e=httpws.bytes.append(borrow mut out,view end[0..50])
    return Ok(out)
}

fn valid_target(host:View<u8>,target:View<u8>)->bool {
    if host.len==0 || host.len>255 || target.len==0 || target.len>1024 || target[0]!=47 {return false}
    var i:u32=0
    while i<host.len {if host[i]<=32 || host[i]>=127 || host[i]==47 || host[i]==92 || host[i]==64 || host[i]==35 {return false};i=i+1}
    i=0;while i<target.len {if target[i]<=32 || target[i]>=127 || target[i]==35 || target[i]==92 {return false};i=i+1}
    return true
}

// Split a sample position into a complete second and remaining samples.
fn seconds(samples: u64, rate: u64) -> u64 {
    return samples / rate
}

fn remainder(samples: u64, rate: u64) -> u64 {
    return samples % rate
}

fn main() -> u32 {
    samples: u64 = 96001
    rate: u64 = 48000
    if seconds(samples, rate) == 2 && remainder(samples, rate) == 1 {
        return 0
    }
    return 1
}

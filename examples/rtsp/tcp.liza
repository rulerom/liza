import rtsp.stream
import httpws.bytes
pub struct Frame {pub data:[u8;4096];pub length:u32}
pub struct Response {pub head:rtsp.stream.Head;pub body:httpws.bytes.Wire}
pub enum Event {Idle;Response(Response);Packet(Frame);Rtcp;Failed}
struct State {connected:bool;pending:httpws.bytes.Wire;sent:u32;length:u32;cursor:u32;blocked:bool;parser:rtsp.stream.State}
pub struct Client {id:net.Connection;buffer:memory.Buffer<u8>;state:State}
pub struct Step {pub client:Client;pub reactor:net.Reactor;pub event:Event}
pub fn create(id:net.Connection,buffer:memory.Buffer<u8>)->Client {return Client(id,move buffer,State(false,httpws.bytes.empty(),0,0,0,false,rtsp.stream.create()))}
pub fn buffered(borrow client:Client)->bool {return client.state.cursor<client.state.length}
pub fn can_send(borrow client:Client)->bool {return client.state.pending.len==0}
pub fn send(owned:Client,wire:httpws.bytes.Wire)->Client {
    (id,buffer,initial)=move owned;var state=initial
    state.pending=wire;state.sent=0;return Client(id,move buffer,state)
}
fn retry(error:ReactorError)->bool {
    match error {ReactorError.WouldBlock=>{return true} ReactorError.Interrupted=>{return true} ReactorError.AddressInUse=>{} ReactorError.PermissionDenied=>{} ReactorError.Disconnected=>{} ReactorError.InvalidRange=>{} ReactorError.Other=>{} ReactorError.InvalidCapacity=>{} ReactorError.Full=>{} ReactorError.InvalidConnection=>{} ReactorError.Exhausted=>{} ReactorError.OutOfMemory=>{}};return false
}
pub fn step(owned:Client,r:net.Reactor)->Step:io {
    (id,initial_buffer,initial)=move owned;var buffer=move initial_buffer;var state=initial;var event=Event.Idle;var failed=false
    if !state.connected {match net.reactor_finish_connect(r,id) {Err(e)=>{if !retry(e) {failed=true}} Ok(ready)=>{state.connected=ready}}}
    if state.blocked {match net.reactor_ready(r,id) {Err(e)=>{failed=true} Ok(flags)=>{if (flags&6)!=0 {state.blocked=false}}}}
    if state.connected&&!failed {
        if state.pending.len!=0&&!state.blocked {
            bytes=state.pending.data
            match net.reactor_write(r,id,view bytes[0..state.pending.len],state.sent,state.pending.len-state.sent) {
                Err(e)=>{if retry(e) {state.blocked=true} else {failed=true}}
                Ok(n)=>{if n==0 {failed=true} else {state.sent=state.sent+n;if state.sent==state.pending.len {state.pending.len=0;state.sent=0}}}
            }
        }
        var processed:u32=0
        while state.cursor<state.length&&processed<256&&!failed {
            var byte:u8=0;{data=memory.view(buffer);byte=data[state.cursor]};state.cursor=state.cursor+1;processed=processed+1
            var parser=state.parser
            match rtsp.stream.feed(borrow mut parser,byte) {
                Err(e)=>{failed=true}
                Ok(code)=>{if code==1 {event=Event.Response(Response(parser.head,parser.body))};if code==2 {event=Event.Packet(Frame(parser.frame,parser.have))};if code==3 {event=Event.Rtcp}}
            }
            state.parser=parser
            match event {Event.Idle=>{} Event.Response(v)=>{break} Event.Packet(v)=>{break} Event.Rtcp=>{break} Event.Failed=>{break}}
        }
        if state.cursor==state.length&&!failed {
            (next,result)=net.reactor_read(r,id,move buffer,0,4096);buffer=move next
            match result {Err(e)=>{if !retry(e) {failed=true}} Ok(n)=>{if n==0 {failed=true} else {state.length=n;state.cursor=0}}}
        }
    }
    var interest:u32=1;if !state.connected||state.pending.len!=0 {interest=interest|2}
    match net.reactor_interest(r,id,interest) {Err(e)=>{failed=true} Ok(n)=>{}}
    if failed {event=Event.Failed}
    return Step(Client(id,move buffer,state),move r,event)
}
pub fn close(owned:Client,r:net.Reactor)->net.Reactor:io {
    (id,buffer,state)=move owned;disconnected=net.reactor_disconnect(r,id);released=memory.release(move buffer);return move r
}

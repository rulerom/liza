import rtsp.bytes
import httpws.http
import httpws.bytes
import can.text
pub struct Head {pub status:u32;pub cseq:u32;pub session:can.text.Value;pub base:can.text.Value;pub transport:can.text.Value;pub content_type:can.text.Value;pub length:u32}
pub struct State {pub header:httpws.bytes.Wire;pub body:httpws.bytes.Wire;pub head:Head;pub phase:u32;pub frame:[u8;4096];pub have:u32;pub needed:u32;pub channel:u8}
pub fn create()->State {b=can.text.empty();return State(httpws.bytes.empty(),httpws.bytes.empty(),Head(0,0,b,b,b,b,0),0,[0;4096],0,0,0)}
fn parse(data:View<u8>)->Result<Head,u32> {
    if data.len<12 {return Err(1)};version:[u8;9]=[82,84,83,80,47,49,46,48,32]
    if !httpws.bytes.equal(data,0,9,view version[0..9],false) {return Err(1)}
    var wire=httpws.bytes.empty();copied=httpws.bytes.append(borrow mut wire,data)
    replacement:[u8;8]=[72,84,84,80,47,49,46,49];var i:u32=0;while i<8 {wire.data[i]=replacement[i];i=i+1}
    check=wire.data
    match httpws.http.response(view check[0..wire.len]) {Err(e)=>{return Err(1)} Ok(found)=>{match found {None=>{return Err(1)} Some(head)=>{}}}}
    var status:u32=0;match rtsp.bytes.number(view data[9..12],999) {Err(e)=>{return Err(1)} Ok(n)=>{status=n}}
    var sequence:u32=0;match rtsp.bytes.field(data,b"CSeq") {Err(e)=>{return Err(1)} Ok(v)=>{b=v.bytes;match rtsp.bytes.number(view b[0..v.length],4294967295) {Err(e)=>{return Err(1)} Ok(n)=>{sequence=n}}}}
    var length:u32=0;match rtsp.bytes.field(data,b"Content-Length") {Err(e)=>{return Err(1)} Ok(v)=>{if v.length!=0 {b=v.bytes;match rtsp.bytes.number(view b[0..v.length],8192) {Err(e)=>{return Err(1)} Ok(n)=>{length=n}}}}}
    var session=can.text.empty();var base=can.text.empty();var transport=can.text.empty();var kind=can.text.empty()
    match rtsp.bytes.field(data,b"Session") {Err(e)=>{return Err(1)} Ok(v)=>{session=v}}
    match rtsp.bytes.field(data,b"Content-Base") {Err(e)=>{return Err(1)} Ok(v)=>{base=v}}
    match rtsp.bytes.field(data,b"Transport") {Err(e)=>{return Err(1)} Ok(v)=>{transport=v}}
    match rtsp.bytes.field(data,b"Content-Type") {Err(e)=>{return Err(1)} Ok(v)=>{kind=v}}
    return Ok(Head(status,sequence,session,base,transport,kind,length))
}
// Payload-byte path: scalar stores into the caller's existing frame storage.
fn frame_byte(borrow mut state:State,byte:u8)->u32 {
    state.frame[state.have]=byte;state.have=state.have+1
    if state.have==state.needed {state.phase=0;if state.channel==0 {return 2};return 3};return 0
}
// 1=response complete, 2=RTP, 3=RTCP. Interleaved channels are negotiated 0/1.
pub fn feed(borrow mut state:State,byte:u8)->Result<u32,u32> {
    if state.phase==0 {
        state.have=0;state.header.len=0;state.body.len=0
        if byte==36 {state.phase=1;return Ok(0)}
        if byte!=82 {return Err(1)};state.phase=4
    }
    if state.phase==1 {if byte>1 {return Err(1)};state.channel=byte;state.phase=2;return Ok(0)}
    if state.phase==2 {state.needed=u32(byte)*256;state.phase=3;return Ok(0)}
    if state.phase==3 {state.needed=state.needed+u32(byte);if state.needed==0||state.needed>4096 {return Err(1)};state.phase=6;return Ok(0)}
    if state.phase==6 {
        return Ok(frame_byte(borrow mut state,byte))
    }
    if state.phase==4 {
        accepted=httpws.bytes.put(borrow mut state.header,byte);if !accepted {return Err(1)}
        n=state.header.len;if n>=4 {if state.header.data[n-4]==13&&state.header.data[n-3]==10&&state.header.data[n-2]==13&&state.header.data[n-1]==10 {
            d=state.header.data
            match parse(view d[0..n]) {Err(e)=>{return Err(1)} Ok(h)=>{state.head=h;state.phase=5;if h.length==0 {state.phase=0;return Ok(1)}}}
        }}
    } else if state.phase==5 {
        accepted=httpws.bytes.put(borrow mut state.body,byte);if !accepted {return Err(1)}
        if state.body.len==state.head.length {state.phase=0;return Ok(1)}
    }
    return Ok(0)
}

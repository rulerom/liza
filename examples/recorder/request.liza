import can.text
import recorder.words
import httpws.bytes
struct Writer {wire:httpws.bytes.Wire;valid:bool}
fn text(writer:Writer,value:can.text.Value)->Writer {
    var next=writer;bytes=value.bytes
    var wire=next.wire;accepted=httpws.bytes.append(borrow mut wire,view bytes[0..value.length]);next.wire=wire
    if !accepted {next.valid=false};return next
}
pub fn decimal(value:u64)->can.text.Value {
    var n=value;var bytes:[u8;20]=[0;20];var at:u32=20
    while true {at=at-1;bytes[at]=u8(n%10)+48;n=n/10;if n==0 {break}}
    match can.text.from_view(view bytes[at..20],20) {Err(e)=>{return can.text.empty()} Ok(v)=>{return v}}
}
pub fn make(host:can.text.Value,token:can.text.Value,target:can.text.Value,kind:u32,filename:can.text.Value,size:u64,offset:u64,content_type:can.text.Value,content_length:u32,body:View<u8>)->Result<httpws.bytes.Wire,u32> {
    // Authority, token and path are generated from trusted configuration or
    // validated server IDs. Still reject header delimiters at this boundary.
    fields:[can.text.Value;4]=[host,token,target,filename];var f:u32=0
    while f<4 {v=fields[f];var i:u32=0;while i<v.length {b=v.bytes[i];if b<33||b>126 {return Err(1)};i=i+1};f=f+1}
    var out=Writer(httpws.bytes.empty(),true);var method=recorder.words.word_post()
    if kind==2 {method=recorder.words.word_put()}
    out=text(out,method);out=text(out,target);out=text(out,recorder.words.word_http_host());out=text(out,host)
    out=text(out,recorder.words.word_http_auth());out=text(out,token);out=text(out,recorder.words.word_http_keep())
    out=text(out,recorder.words.word_http_type());out=text(out,content_type)
    if kind==1 {
        out=text(out,recorder.words.word_upload_name());out=text(out,filename)
        out=text(out,recorder.words.word_upload_size());out=text(out,decimal(size));out=text(out,recorder.words.word_upload_scope())
    }
    if kind==2 {out=text(out,recorder.words.word_upload_offset());out=text(out,decimal(offset))}
    out=text(out,recorder.words.word_http_size());out=text(out,decimal(u64(content_length)));out=text(out,recorder.words.word_http_end())
    var wire=out.wire;accepted=httpws.bytes.append(borrow mut wire,body)
    if !accepted||!out.valid {return Err(1)}
    return Ok(wire)
}

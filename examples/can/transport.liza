import httpws.bytes
import httpws.crypto
import httpws.http
import can.text
import can.words
import can.messages
import can.logic
import can.encode
import can.websocket
import can.config
import can.storage
import can.socket
pub enum Error {Tls(TlsError);Protocol;Policy;Deadline;Memory}
pub struct Stats {pub generation:u64;pub completed:u64;pub cancelled:u64;pub ready:bool}
fn retry(e:ReactorError)->bool {
    match e {ReactorError.Interrupted=>{return true} ReactorError.WouldBlock=>{return true}
    ReactorError.AddressInUse=>{return false} ReactorError.PermissionDenied=>{return false}
    ReactorError.Disconnected=>{return false} ReactorError.InvalidRange=>{return false}
    ReactorError.Other=>{return false} ReactorError.InvalidCapacity=>{return false}
    ReactorError.Full=>{return false} ReactorError.InvalidConnection=>{return false}
    ReactorError.Exhausted=>{return false} ReactorError.OutOfMemory=>{return false}}
}
fn state_number(state:TlsState)->u32 {
    match state {TlsState.Handshake=>{return 0} TlsState.Open=>{return 1} TlsState.Closing=>{return 2} TlsState.Done=>{return 3} TlsState.Dead=>{return 4} TlsState.Unavailable=>{return 5}}
}
fn closed(outcome:TlsOutcome)->bool {match outcome {TlsOutcome.Progress=>{return false} TlsOutcome.Want=>{return false} TlsOutcome.Closed=>{return true}}}
// Log schema diagnostics only; never print the received message or credentials.
fn message_error(error:can.messages.Error)->u32:io {
    match error {
        can.messages.Error.Missing(field)=>{a=console.errln("CAN message: missing required field");b=console.print_u64(u64(field));c=console.println("")}
        can.messages.Error.WrongType(field)=>{a=console.errln("CAN message: wrong field type");b=console.print_u64(u64(field));c=console.println("")}
        can.messages.Error.TooLarge(field)=>{a=console.errln("CAN message: field exceeds limit")}
        can.messages.Error.BadValue(field)=>{a=console.errln("CAN message: invalid field value")}
        can.messages.Error.Json(json_error)=>{a=console.errln("CAN message: invalid JSON")}
    }
    return 0
}
// Echo policy over the shared owned WSS/TLS session; Recorder reuses the session.
fn exchange(session:tls.Session,r:net.Reactor,id:net.Connection,bundle:can.storage.Bundle,request:httpws.bytes.Wire,proof:[u8;28],config:can.config.Config,generation:u64,run_until:u64,started:u64)->Result<Stats,Error>:io,alloc {
    (network,initial_document,initial_scratch,initial_output)=move bundle
    var reactor=move r
    var socket=can.socket.create(move session,id,move network,request,proof,started+u64(config.operation_ms),config.close_ms)
    var document=move initial_document;var scratch=move initial_scratch;var output=move initial_output
    var model=can.logic.create(config.node,generation)
    var failure:Option<Error> =None;var upgraded=false;var hello_due:u64=0
    var stopping=false;var local_stop=false;var close_due:u64=0
    while true {
        var now:u64=0;match net.monotonic_ms() {Err(e)=>{failure=Some(Error.Tls(TlsError.Transport(e)));break} Ok(n)=>{now=n}}
        if now>=run_until&&!stopping {stopping=true;local_stop=true;close_due=now+u64(config.close_ms);model.active=false;socket=can.socket.stop(move socket,close_due)}
        if close_due!=0&&now>=close_due {failure=Some(Error.Deadline);break}
        if upgraded&&!model.registered&&hello_due!=0&&now>=hello_due {failure=Some(Error.Deadline);break}
        if upgraded&&!stopping {
            status=can.logic.tick(borrow mut model,now,u64(config.operation_ms),!can.socket.buffered(socket))
            if status!=0 {failure=Some(Error.Deadline);break}
            if can.socket.can_send(socket) {
                match can.logic.take(borrow mut model) {None=>{} Some(queued)=>{
                    if queued.generation!=generation {failure=Some(Error.Protocol);break}
                    (encoded,length,result)=can.encode.message(move output,queued,config.token);output=move encoded
                    match result {Err(e)=>{failure=Some(Error.Protocol);break} Ok(n)=>{}}
                    {bytes=memory.view(output);(next,sent)=can.socket.send(move socket,1,view bytes[0..length],now+u64(config.operation_ms));socket=move next
                    match sent {Err(e)=>{failure=Some(Error.Protocol)} Ok(accepted)=>{if !accepted {failure=Some(Error.Protocol)}}}}
                    match failure {Some(e)=>{break} None=>{}}
                }}
            }
        }
        var until=run_until;if stopping {until=close_due} else {until=can.logic.deadline(model,until);if upgraded&&!model.registered&&hello_due<until {until=hello_due}}
        (next_socket,next_reactor,event)=can.socket.step(move socket,move reactor,now,until);socket=move next_socket;reactor=move next_reactor
        match event {
            can.socket.Event.Idle=>{}
            can.socket.Event.Upgraded=>{upgraded=true;hello_due=now+u64(config.operation_ms)}
            can.socket.Event.Message(frame)=>{
                if !stopping {
                    bytes=frame.bytes;var i:u32=0;while i<frame.length {document=memory.set(move document,i,bytes[i]);i=i+1}
                    (next_document,next_scratch,result)=can.messages.parse(move document,frame.length,move scratch);document=move next_document;scratch=move next_scratch
                    match result {Err(e)=>{reported=message_error(e);failure=Some(Error.Protocol)} Ok(message)=>{
                        ready_before=model.registered
                        status=can.logic.receive(borrow mut model,message,generation,now,u64(config.operation_ms))
                        if status!=0 {if model.policy {failure=Some(Error.Policy)} else {failure=Some(Error.Protocol)}}
                        if !ready_before&&model.registered {log=console.println("CAN ready")}
                    }}
                    match failure {Some(e)=>{break} None=>{}}
                }
            }
            can.socket.Event.PeerClosed=>{stopping=true;close_due=now+u64(config.close_ms);model.active=false}
            can.socket.Event.Closed=>{if !local_stop {failure=Some(Error.Tls(TlsError.Transport(ReactorError.Disconnected)))};break}
            can.socket.Event.Failed(error)=>{
                match error {can.socket.Error.Protocol=>{failure=Some(Error.Protocol)} can.socket.Error.Deadline=>{failure=Some(Error.Deadline)} can.socket.Error.Tls(e)=>{failure=Some(Error.Tls(e))}};break
            }
        }
    }
    a=memory.release(move document);b=memory.release(move scratch);c=memory.release(move output)
    (last_reactor,closed)=can.socket.close(move socket,move reactor)
    reactor_closed=net.reactor_close(move last_reactor)
    match closed {Err(error)=>{match error {can.socket.Error.Tls(e)=>{failure=Some(Error.Tls(e))} can.socket.Error.Protocol=>{failure=Some(Error.Protocol)} can.socket.Error.Deadline=>{failure=Some(Error.Deadline)}}} Ok(n)=>{}}
    match failure {Some(error)=>{return Err(error)} None=>{return Ok(Stats(generation,model.completed,model.cancelled,model.registered))}}
}
fn start(session:tls.Session,config:can.config.Config,request:httpws.bytes.Wire,proof:[u8;28],generation:u64,until:u64,now:u64)->Result<Stats,Error>:io,alloc {
    match net.reactor_create(0,1) {Err(e)=>{d=tls.destroy(move session);return Err(Error.Tls(TlsError.Transport(e)))} Ok(r)=>{
        match net.reactor_stop_accepting(r) {Err(e)=>{c=net.reactor_close(move r);d=tls.destroy(move session);return Err(Error.Tls(TlsError.Transport(e)))} Ok(n)=>{}}
        match net.reactor_connect_at(r,config.address) {Err(e)=>{c=net.reactor_close(move r);d=tls.destroy(move session);return Err(Error.Tls(TlsError.Transport(e)))} Ok(id)=>{
            match memory.create(24576) {Err(e)=>{c=net.reactor_close(move r);d=tls.destroy(move session);return Err(Error.Memory)} Ok(region)=>{
 match memory.alloc<u8>(region,12288,0) {Err(e)=>{c=memory.close(move region);closed=net.reactor_close(move r);destroyed=tls.destroy(move session);return Err(Error.Memory)} Ok(network)=>{
 match memory.alloc<u8>(region,4096,0) {Err(e)=>{free0=memory.release(move network);c=memory.close(move region);closed=net.reactor_close(move r);destroyed=tls.destroy(move session);return Err(Error.Memory)} Ok(document)=>{
 match memory.alloc<u8>(region,1024,0) {Err(e)=>{free1=memory.release(move document);free0=memory.release(move network);c=memory.close(move region);closed=net.reactor_close(move r);destroyed=tls.destroy(move session);return Err(Error.Memory)} Ok(scratch)=>{
 match memory.alloc<u8>(region,4096,0) {Err(e)=>{free2=memory.release(move scratch);free1=memory.release(move document);free0=memory.release(move network);c=memory.close(move region);closed=net.reactor_close(move r);destroyed=tls.destroy(move session);return Err(Error.Memory)} Ok(output)=>{
 bundle=can.storage.Bundle(move network,move document,move scratch,move output)
 result=exchange(move session,move r,id,move bundle,request,proof,config,generation,until,now);closed=memory.close(move region);return result
 }}
 }}
 }}
 }}
 }}

        }}
    }}
}
pub fn run(config:can.config.Config,generation:u64,until:u64)->Result<Stats,Error>:io,alloc {
    var now:u64=0;match net.monotonic_ms() {Err(e)=>{return Err(Error.Tls(TlsError.Transport(e)))} Ok(n)=>{now=n}}
    var nonce:[u8;16]=[0;16];var i:u32=0
    while i<4 {match net.random_u32() {Err(e)=>{return Err(Error.Protocol)} Ok(n)=>{nonce[i*4]=u8.wrap(n>>24);nonce[i*4+1]=u8.wrap(n>>16);nonce[i*4+2]=u8.wrap(n>>8);nonce[i*4+3]=u8.wrap(n)}};i=i+1}
    key=httpws.crypto.key(nonce);proof=httpws.crypto.accept(key)
    host=config.host.bytes;peer=config.peer.bytes;ca=config.ca.bytes;target:[u8;4]=[47,99,97,110]
    var request=httpws.bytes.empty()
    match httpws.http.request(view host[0..config.host.length],view target[0..4],key) {Err(e)=>{return Err(Error.Protocol)} Ok(w)=>{request=w}}
    if config.custom {match tls.create_with_ca(view peer[0..config.peer.length],view ca[0..config.ca.length],tls.managed_bytes(),now,until+u64(config.close_ms)) {Err(e)=>{return Err(Error.Tls(e))} Ok(session)=>{return start(move session,config,request,proof,generation,until,now)}}}
    match tls.create(view peer[0..config.peer.length],tls.managed_bytes(),now,until+u64(config.close_ms)) {Err(e)=>{return Err(Error.Tls(e))} Ok(session)=>{return start(move session,config,request,proof,generation,until,now)}}
}

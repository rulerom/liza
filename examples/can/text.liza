pub struct Value {pub bytes:[u8;1024];pub length:u32}
pub enum Error {TooLarge;InvalidUtf8}
pub fn empty()->Value {return Value([0;1024],0)}
pub fn from_view(data:View<u8>,limit:u32)->Result<Value,Error> {
    if data.len>limit||data.len>1024 {return Err(Error.TooLarge)}
    match utf8.validate(data) {Err(e)=>{return Err(Error.InvalidUtf8)} Ok(n)=>{}}
    var out=empty();var i:u32=0;while i<data.len {out.bytes[i]=data[i];i=i+1};out.length=data.len;return Ok(out)
}
pub fn equal(borrow a:Value,borrow b:Value)->bool {
    if a.length!=b.length {return false};var i:u32=0;while i<a.length {if a.bytes[i]!=b.bytes[i] {return false};i=i+1};return true
}

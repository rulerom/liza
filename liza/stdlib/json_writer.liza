fn json.begin_object(writer:JsonWriter)->JsonWritten {return __liza_json_writer_open(move writer,true)}
fn json.begin_array(writer:JsonWriter)->JsonWritten {return __liza_json_writer_open(move writer,false)}
fn __liza_json_writer_close(writer:JsonWriter,object:bool)->JsonWritten {

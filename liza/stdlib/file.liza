// Bounded whole-file input. Capacity and zero-filled tail are part of this API.
enum FileError { NotFound; PermissionDenied; TooLarge; InvalidPath; PathTooLong; WouldBlock; Other }
struct FileFailure { kind:FileError; read:u32 }
struct FileBuffer { data:[u8;2048]; len:u32 }
struct __liza_FileRead { data:[u8;2048]; status:u64 }
fn file.read(path:Text)->Result<FileBuffer,FileFailure>:io {
    raw=__liza_read_file(path)
    count=u32.wrap(raw.status)
    code=raw.status >> 32
    if code==0 {return Ok(FileBuffer(raw.data,count))}
    if code==1 {return Err(FileFailure(FileError.NotFound,count))}
    if code==2 {return Err(FileFailure(FileError.PermissionDenied,count))}
    if code==3 {return Err(FileFailure(FileError.TooLarge,count))}
    if code==4 {return Err(FileFailure(FileError.InvalidPath,count))}
    if code==5 {return Err(FileFailure(FileError.PathTooLong,count))}
    if code==6 {return Err(FileFailure(FileError.WouldBlock,count))}
    return Err(FileFailure(FileError.Other,count))
}

// File is opaque and move-only. Only this trusted adapter handles raw handles.
struct __liza_FileOpen { handle:File; error:u32 }
struct FileChunk { data:[u8;2048]; len:u32; eof:bool }
fn __liza_file_error(code:u32)->FileError {
    if code==1 {return FileError.NotFound}
    if code==2 {return FileError.PermissionDenied}
    if code==3 {return FileError.TooLarge}
    if code==4 {return FileError.InvalidPath}
    if code==5 {return FileError.PathTooLong}
    if code==6 {return FileError.WouldBlock}
    return FileError.Other
}
fn file.open(path:Text)->Result<File,FileError>:io {
    raw=__liza_file_open(path)
    if raw.error==0 {return Ok(raw.handle)}
    return Err(__liza_file_error(raw.error))
}
fn file.close(handle:File)->Result<u32,FileError>:io {
    code=__liza_file_close(handle)
    if code==0 {return Ok(0)}
    return Err(__liza_file_error(code))
}
fn file.read_chunk(handle:File)->Result<FileChunk,FileFailure>:io {
    raw=__liza_read_chunk(handle)
    count=u32.wrap(raw.status)
    code=u32(raw.status >> 32)
    if code==0 {return Ok(FileChunk(raw.data,count,count==0))}
    return Err(FileFailure(__liza_file_error(code),count))
}

fn file.open_path(path:Path)->Result<File,FileError>:io {
    raw=__liza_file_open_path(path)
    if raw.error==0 {return Ok(raw.handle)}
    return Err(__liza_file_error(raw.error))
}

// Separate domains preserve existing exhaustive FileError matches.
enum FileCreateError { AlreadyExists; Failure(FileError) }
enum FileWriteError { InvalidHandle; PermissionDenied; NoSpace; WouldBlock; WriteZero; TooLarge; Other }
struct FileWriteFailure { kind:FileWriteError; written:u32 }

fn file.create_path(path:Path)->Result<File,FileCreateError>:io {
    raw=__liza_file_create_path(path)
    if raw.error==0 {return Ok(raw.handle)}
    if raw.error==8 {return Err(FileCreateError.AlreadyExists)}
    return Err(FileCreateError.Failure(__liza_file_error(raw.error)))
}

fn __liza_file_write_error(code:u32)->FileWriteError {
    if code==1 {return FileWriteError.InvalidHandle}
    if code==2 {return FileWriteError.PermissionDenied}
    if code==3 {return FileWriteError.NoSpace}
    if code==4 {return FileWriteError.WouldBlock}
    if code==5 {return FileWriteError.WriteZero}
    if code==6 {return FileWriteError.TooLarge}
    return FileWriteError.Other
}

fn file.write_chunk(handle:File, data:View<u8>)->Result<u32,FileWriteFailure>:io {
    raw=__liza_file_write(handle,data)
    written=u32.wrap(raw)
    code=u32(raw >> 32)
    if code==0 {return Ok(written)}
    return Err(FileWriteFailure(__liza_file_write_error(code),written))
}

fn file.flush(handle:File)->Result<u32,FileWriteError>:io {
    code=__liza_file_flush(handle)
    if code==0 {return Ok(0)}
    return Err(__liza_file_write_error(code))
}

// Metadata never follows the final symlink. Missing is a successful observation.
enum FsError {NotFound;PermissionDenied;AlreadyExists;NotDirectory;IsDirectory;InvalidPath;NoSpace;Other}
enum FileKind {Missing;Regular;Directory;Symlink;Other}
struct FileInfo {kind:FileKind;size:u64}
struct __liza_FileInfo {error:u32;kind:u32;size:u64}
fn __liza_fs_error(code:u32)->FsError {
    if code==1 {return FsError.NotFound};if code==2 {return FsError.PermissionDenied}
    if code==3 {return FsError.AlreadyExists};if code==4 {return FsError.NotDirectory}
    if code==5 {return FsError.IsDirectory};if code==6 {return FsError.InvalidPath}
    if code==7 {return FsError.NoSpace};return FsError.Other
}
fn file.stat(path:Path)->Result<FileInfo,FsError>:io {
    raw=__liza_fs_stat(path)
    if raw.error!=0 {return Err(__liza_fs_error(raw.error))}
    var kind=FileKind.Other
    if raw.kind==0 {kind=FileKind.Missing};if raw.kind==1 {kind=FileKind.Regular}
    if raw.kind==2 {kind=FileKind.Directory};if raw.kind==3 {kind=FileKind.Symlink}
    return Ok(FileInfo(kind,raw.size))
}
fn file.mkdir(path:Path)->Result<u32,FsError>:io {
    code=__liza_fs_op(path,1)
    if code!=0 {return Err(__liza_fs_error(code))};return Ok(0)
}
fn file.remove(path:Path)->Result<u32,FsError>:io {
    code=__liza_fs_op(path,2)
    if code!=0 {return Err(__liza_fs_error(code))};return Ok(0)
}

// Dynamic bounded UTF-8 names for application-owned artifact directories.
fn __liza_fs_valid_name(path:View<u8>)->bool {
    if path.len==0||path.len>4096 {return false}
    var i:u32=0;while i<path.len {if path[i]==0 {return false};i=i+1}
    match utf8.validate(path) {Err(e)=>{return false} Ok(done)=>{return true}}
}
fn file.stat_utf8(path:View<u8>)->Result<FileInfo,FsError>:io {
    if !__liza_fs_valid_name(path) {return Err(FsError.InvalidPath)}
    raw=__liza_fs_utf8_stat(path)
    if raw.error!=0 {return Err(__liza_fs_error(raw.error))}
    var kind=FileKind.Other
    if raw.kind==0 {kind=FileKind.Missing};if raw.kind==1 {kind=FileKind.Regular}
    if raw.kind==2 {kind=FileKind.Directory};if raw.kind==3 {kind=FileKind.Symlink}
    return Ok(FileInfo(kind,raw.size))
}
fn file.mkdir_utf8(path:View<u8>)->Result<u32,FsError>:io {
    if !__liza_fs_valid_name(path) {return Err(FsError.InvalidPath)}
    code=__liza_fs_utf8_op(path,1);if code!=0 {return Err(__liza_fs_error(code))};return Ok(0)
}
fn file.remove_utf8(path:View<u8>)->Result<u32,FsError>:io {
    if !__liza_fs_valid_name(path) {return Err(FsError.InvalidPath)}
    code=__liza_fs_utf8_op(path,2);if code!=0 {return Err(__liza_fs_error(code))};return Ok(0)
}
fn file.create_utf8(path:View<u8>)->Result<File,FileCreateError>:io {
    if !__liza_fs_valid_name(path) {return Err(FileCreateError.Failure(FileError.InvalidPath))}
    raw=__liza_fs_utf8_file(path,true)
    if raw.error==0 {return Ok(raw.handle)}
    if raw.error==8 {return Err(FileCreateError.AlreadyExists)}
    return Err(FileCreateError.Failure(__liza_file_error(raw.error)))
}
fn file.open_utf8(path:View<u8>)->Result<File,FileError>:io {
    if !__liza_fs_valid_name(path) {return Err(FileError.InvalidPath)}
    raw=__liza_fs_utf8_file(path,false)
    if raw.error==0 {return Ok(raw.handle)};return Err(__liza_file_error(raw.error))
}

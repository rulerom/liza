            None=>{}
            Some(e)=>{match e.kind {
                Utf8StreamErrorKind.InvalidEncoding=>{return __liza_json_mut_fail(5,e.offset,borrow mut n)}
                Utf8StreamErrorKind.SizeOverflow=>{return __liza_json_mut_fail(8,e.offset,borrow mut n)}
            }}
